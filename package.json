{
  "name": "@space-spacee-clamation/dsh-feishu-cli",
  "version": "1.0.0",
  "description": "Feishu/Lark CLI agent preset for DeepSeek Harness: the lark-cli tool plus every vendored lark-* skill (Sheets, Base, Docs, Drive, IM, Calendar, Mail and more).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "dsh-preset",
    "feishu",
    "lark",
    "lark-cli",
    "bitable",
    "sheets"
  ],
  "author": "space-spacee-clamation",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/space-spacee-clamation/dsh-feishu-cli.git"
  },
  "homepage": "https://github.com/space-spacee-clamation/dsh-feishu-cli#readme",
  "bugs": {
    "url": "https://github.com/space-spacee-clamation/dsh-feishu-cli/issues"
  },
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  }
}
